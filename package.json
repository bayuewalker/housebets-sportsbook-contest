{
  "name": "house-live",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/preview.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --import tsx --test tests/*.test.ts",
    "watch": "vite --host 0.0.0.0",
    "pages:prepare": "pnpm lint && pnpm test && pnpm build && node scripts/prepare-pages.mjs",
    "pages:verify": "node scripts/verify-pages.mjs",
    "qa:browser": "node scripts/qa-browser.mjs",
    "qa:stress": "node scripts/qa-stress.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "playwright-core": "1.56.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
